# Copiá este archivo a .env.local (o usá `vercel env pull .env.local`). NUNCA commitees valores reales.

# --- WhatsApp Cloud API (Meta) ---
# Token permanente de System User (no el temporal de 24 h)
WHATSAPP_TOKEN=
# ID del número (Phone number ID) en WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de la app de Meta (para validar X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Texto cualquiera que inventás vos y pegás también en la config del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API
WHATSAPP_API_VERSION=v23.0
# "true" = no se envía nada a Meta: los envíos se registran como simulados (útil en local)
WHATSAPP_DRY_RUN=true

# --- Claude ---
ANTHROPIC_API_KEY=
# Modelo que redacta las respuestas (handover §4)
CLAUDE_MODEL=claude-sonnet-5-5

# --- Base de datos (Neon vía Vercel Marketplace) ---
DATABASE_URL=

# --- Panel ---
PANEL_ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión del panel (32+ caracteres al azar)
SESSION_SECRET=

# --- Cron de Vercel ---
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
